# Copy to .env and fill in. NEVER commit .env.
#
# Only VITE_-prefixed variables reach the browser. That is deliberate:
# it makes it impossible to leak a server secret by accident.

# Supabase — Settings > API in the dashboard
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL. Used by canonical tags, hreflang, sitemap, Open Graph and
# JSON-LD, so switching to the real domain later is a config change only (D-177).
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefixed with VITE_, never sent to the browser.
# Set these in Netlify > Site settings > Environment variables.
# ---------------------------------------------------------------------------
# SITE_URL=https://your-domain.com   <- server copy, used by sitemap + robots
# SUPABASE_ANON_KEY=                 <- server copy, used by sitemap + edge fn
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      <- bypasses RLS entirely. Server only.
#
# Google Sheets sync (Phase 9)
# GOOGLE_SERVICE_ACCOUNT_JSON=    <- the whole JSON file, on one line
# GOOGLE_SHEET_ID=                <- from the sheet URL
# GOOGLE_SHEET_TAB=Commandes
# SYNC_SECRET=                    <- any random string; guards the endpoint
#
# NETLIFY_BUILD_HOOK_URL=
